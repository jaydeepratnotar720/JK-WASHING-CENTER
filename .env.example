# ==========================================
# JK WASHING CENTER - ENVIRONMENT CONFIGURATION
# ==========================================

# 1. Supabase PostgreSQL & Auth (Required for production cloud database)
# Get these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key"

# Supabase Service Role Key (SERVER ONLY - NEVER expose to browser)
# Used for initial admin provisioning and administrative webhooks
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key"

# 2. Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 3. Razorpay Payment Gateway (Optional - for online customer advance/full payments)
# Test mode keys start with rzp_test_
RAZORPAY_KEY_ID="rzp_test_YourKeyIdHere"
RAZORPAY_KEY_SECRET="YourRazorpaySecretKeyHere"
RAZORPAY_WEBHOOK_SECRET="YourRazorpayWebhookSecretHere"

# 4. Business Default Contact Info (Overrides can also be set in Admin Settings UI)
NEXT_PUBLIC_BUSINESS_NAME="JK WASHING CENTER"
NEXT_PUBLIC_BUSINESS_TAGLINE="Your Car. Your Bike. Our Shine."
NEXT_PUBLIC_BUSINESS_PHONE="+91 98765 43210"
NEXT_PUBLIC_BUSINESS_EMAIL="contact@jkwashingcenter.com"
NEXT_PUBLIC_BUSINESS_ADDRESS="Plot 42, Service Road, Near Highway Junction, Mumbai, Maharashtra 400001"
